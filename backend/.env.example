# Lynks Backend Environment Variables
# Copy this to .env and fill in real values

# ── Supabase ───────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── PostgreSQL (Supabase Pooler) ───────────────────────────────────────────
# Use the Transaction-mode pooler URL from Supabase Dashboard → Settings → Database
DATABASE_URL=postgresql+asyncpg://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# ── LLM — OpenAI-compatible compute gateway ────────────────────────────────
# This is the Highrise / Impala AI gateway that exposes an OpenAI-compatible API.
# Base URL points to their endpoint; API key comes from the buildathon sponsors.
LLM_API_BASE_URL=https://api.highrise.ai/v1
LLM_API_KEY=your-buildathon-api-key
LLM_MODEL=llama-3-70b

# ── Test Config ────────────────────────────────────────────────────────────
# Used by tests/get_token.ps1 to auto-generate fresh JWT tokens
# Create this user in Supabase → Authentication → Users first
TEST_EMAIL=test@lynks.com
TEST_PASSWORD=TestPassword123!
# Auto-populated by get_token.ps1 — do not paste manually
JWT_TOKEN=
